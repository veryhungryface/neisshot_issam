{
  "manifest_version": 3,
  "name": "나이스입력도우미 by issamGPT",
  "version": "1.4",
  "description": "나이스(NEIS) 학생 데이터 일괄 입력 보조 도구",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://issamgpt.com/*",
    "https://*.issamgpt.com/*",
    "https://neis.go.kr/*",
    "https://*.neis.go.kr/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://student-record-ai-editor.vercel.app/*",
      "https://student-record-ai-editor-cxk5.vercel.app/*",
      "https://veryhungryface.github.io/student-record-ai-editor/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "나이스입력도우미 by issamGPT 열기",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "나이스입력도우미 사이드패널 열기"
    }
  }
}
